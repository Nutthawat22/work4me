{
  "litellm_url": "https://opencode.ai/zen/go/v1",
  "litellm_key": "YOUR_OPENCODE_GO_API_KEY_HERE",
  "models": {
    "_comment": "provider is always \"acp\" (routes through a pooled `opencode acp` subprocess — see src/specialists/providers/acp_client.py). ACP has no token-level schema enforcement; JSON reliability is handled via a prompt-embedded schema instruction plus same-session retry-with-error-feedback (acp_call_with_retry), not a hard guarantee.",
    "code": {"model": "kimi-k2.7-code", "provider": "acp"},
    "default": {"model": "kimi-k2.7-code", "provider": "acp"},
    "master": {"model": "kimi-k2.7-code", "provider": "acp"},
    "design": {"model": "gpt-5.6-luna", "provider": "acp"},
    "specialist": {"model": "kimi-k2.7-code", "provider": "acp"}
  },
  "pipeline": {
    "max_retries": 3,
    "runs_dir": "runs/",
    "output_dir": "product",
    "tests_dir": "tests",
    "max_prompt_content_chars": 200000
  },
  "languages": {
    "python": {
      "test_command": ["pytest", "{tests_dir}", "--junitxml={junit_path}"],
      "file_extension": ".py",
      "test_framework_name": "pytest"
    },
    "javascript": {
      "test_command": ["npx", "jest", "--ci", "--json", "--outputFile", "{result_path}", "--roots", "{tests_dir}"],
      "file_extension": [".js", ".jsx"],
      "test_framework_name": "jest"
    },
    "typescript": {
      "test_command": ["bunx", "vitest", "run", "{tests_dir}", "--reporter=json", "--outputFile={result_path}"],
      "file_extension": [".ts", ".tsx"],
      "test_framework_name": "vitest"
    }
  }
}
